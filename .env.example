# Port des Servers
PORT=8080

# Zeitzone für Kalender & Essensplan
TZ_DEFAULT=Europe/Berlin

# Optional: Kalender per Umgebungsvariable (sonst in den Einstellungen der App eintragen)
# Mehrere Links mit Komma trennen. webcal:// wird automatisch zu https://
# ICS_URLS=webcal://p01-caldav.icloud.com/published/2/XXXXXXXX

# Optional: Bring!-Zugangsdaten (sonst in den Einstellungen der App eintragen)
# BRING_EMAIL=familie@example.de
# BRING_PASSWORD=geheim
# BRING_LIST_UUID=

# Optional: PIN, die zum Ändern der Einstellungen nötig ist
# ADMIN_PIN=1234

# Demo-Modus mit Beispiel-Terminen & Beispiel-Einkaufsliste
# DEMO=1
